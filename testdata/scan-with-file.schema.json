{
  "$defs": {
    "File": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        },
        "contentType": {
          "default": "",
          "title": "Contenttype",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "name",
        "sha256",
        "size"
      ],
      "title": "File",
      "type": "object",
      "x-kontra-input": "file"
    },
    "Folder": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/File"
          },
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Folder",
      "type": "object",
      "x-kontra-input": "folder"
    }
  },
  "properties": {
    "corpus": {
      "$ref": "#/$defs/File"
    },
    "strict": {
      "default": false,
      "title": "Strict",
      "type": "boolean"
    },
    "verbose": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verbose"
    },
    "mode": {
      "default": "fast",
      "title": "Mode",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "$ref": "#/$defs/Folder"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "corpus"
  ],
  "title": "Scan",
  "type": "object"
}
