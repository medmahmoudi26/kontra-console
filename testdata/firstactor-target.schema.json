{
  "$defs": {
    "File": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        },
        "contentType": {
          "default": "",
          "title": "Contenttype",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "name",
        "sha256",
        "size"
      ],
      "title": "File",
      "type": "object",
      "x-kontra-input": "file"
    },
    "Folder": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/File"
          },
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Folder",
      "type": "object",
      "x-kontra-input": "folder"
    }
  },
  "properties": {
    "host": {
      "title": "Host",
      "type": "string"
    },
    "mode": {
      "default": "quick",
      "enum": [
        "quick",
        "deep"
      ],
      "title": "Mode",
      "type": "string"
    },
    "follow_redirects": {
      "default": false,
      "title": "Follow Redirects",
      "type": "boolean"
    },
    "wordlist": {
      "anyOf": [
        {
          "$ref": "#/$defs/File"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "corpus": {
      "anyOf": [
        {
          "$ref": "#/$defs/Folder"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "host"
  ],
  "title": "Target",
  "type": "object"
}
