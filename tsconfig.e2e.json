{
  // THE ONE PROJECT THAT NEEDS THE ORCHESTRATOR'S SOURCE, kept separate so that it is the only one.
  //
  // `e2e/streamer.ts` constructs a real `PanelServer` from `kontra/control/orchestrator/src/panels/server` — not
  // a mock of one — because the whole claim of the Monitor e2e is that a browser can read what the
  // orchestrator actually writes. That code is server-side (it reaches ssh, discovery and probe),
  // so it cannot move into `@kontra/core`, and there is no version of this harness that does not
  // need the other repository on disk.
  //
  // SO IT IS FENCED RATHER THAN HIDDEN. `tsconfig.json` covers `src` alone and typechecks with
  // nothing but this repository checked out; this file covers `e2e` and requires kontra to be a
  // SIBLING DIRECTORY NAMED `kontra`:
  //
  //     parent/
  //       kontra/            <- github.com/medmahmoudi26/kontra
  //       kontra-console/    <- this repository
  //
  // `pnpm typecheck` is the standalone one. `pnpm typecheck:e2e` is the one that needs the sibling,
  // and it fails with `Cannot find module '../../kontra/control/orchestrator/...'` when it is missing — which
  // names the requirement rather than describing a compiler bug.
  "extends": "./tsconfig.json",
  "include": ["e2e"]
}
